# Copy to .env and adjust.

# PostgreSQL (docker compose up -d db starts one with these credentials)
DATABASE_URL=postgresql+psycopg://vaani:vaani@localhost:5432/vaani

# Speech-to-text engine: "gemini" (Gemini Live API) or "whisper" (local faster-whisper, open source)
STT_PROVIDER=gemini

# Gemini Live — free API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live
# VERBATIM keeps every word as spoken; SMART removes fillers and lightly cleans up the text.
GEMINI_TRANSCRIPTION_MODE=VERBATIM

# faster-whisper (STT_PROVIDER=whisper): tiny | base | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Maximum length of one recording, in seconds
MAX_SESSION_SECONDS=600

# Text-to-speech voices (Piper, open source). Download with: python scripts/download_models.py
PIPER_VOICE_EN=en_US-lessac-medium
PIPER_VOICE_HI=hi_IN-priyamvada-medium
